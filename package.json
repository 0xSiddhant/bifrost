{
  "name": "bifrost",
  "version": "1.4.0",
  "private": true,
  "description": "LAN-only file transfer & sync hub — your devices, connected by the rainbow bridge",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "server",
    "client",
    "web",
    "cli",
    "e2e"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -n api,client,mdns -c blue,magenta,gray \"npm run dev -w server\" \"npm run dev -w client\" \"npm run mdns:dev -w web\"",
    "build": "npm run build -w client && npm run build:standalone -w client && npm run build -w server && npm run build -w web && tsx scripts/cli-sync.ts",
    "dev:standalone": "npm run dev:standalone -w client",
    "build:standalone": "npm run build:standalone -w client",
    "preview:standalone": "npm run build:standalone && npm run preview:standalone -w client",
    "start": "tsx scripts/cli-sync.ts && tsx scripts/start.ts",
    "logs": "tail -F storage/logs/current.log | pino-pretty --levelKey logLevel",
    "db:studio": "npm run db:studio -w server",
    "changelog": "changelogen --output CHANGELOG.md",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "backup:install": "sh scripts/backup-agent.sh install",
    "backup:uninstall": "sh scripts/backup-agent.sh uninstall",
    "backup:start": "sh scripts/backup-agent.sh start",
    "backup:stop": "sh scripts/backup-agent.sh stop",
    "backup:status": "sh scripts/backup-agent.sh status",
    "backup:run": "sh scripts/backup-agent.sh run",
    "test:resilience": "tsx scripts/resilience.ts",
    "api:spec": "tsx scripts/gen-openapi.ts",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "prepare": "husky",
    "test:e2e": "npm run test:e2e -w e2e",
    "test:load": "npm run test:load -w e2e --"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "shell-quote": "^1.12.0",
    "micromatch": "$micromatch",
    "autocannon": {
      "hyperid": "^4.0.0"
    },
    "mermaid": {
      "katex": "^0.19.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "husky": "^9.1.7",
    "micromatch": "file:tools/micromatch-shim",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.63.0"
  }
}
