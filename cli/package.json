{
  "name": "bifrost-cli",
  "version": "1.3.0",
  "private": true,
  "description": "Command-line client for a Bifrost LAN hub — push, pull, clipboard, documents, go-links, speed test",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bifrost": "./dist/index.js"
  },
  "man": [
    "./man/bifrost.1"
  ],
  "files": [
    "dist",
    "man/bifrost.1",
    "README.md"
  ],
  "scripts": {
    "prebuild": "tsx ../scripts/gen-man.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "marked-man": "^2.1.1",
    "vitest": "^4.1.10"
  }
}
