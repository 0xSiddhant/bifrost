# ── Bifrost configuration ──────────────────────────────────────────
# Copy to .env (npm run setup does this) and fill in the blanks.
# Every value here is validated at boot (core/config); bad values fail fast.

# Which module set to load: local = everything (LAN hub), cloud = internet-safe modules only
DEPLOY_PROFILE=local

# HTTP port the single Fastify process listens on
PORT=4646

# mDNS/Bonjour name — devices reach the hub at http://<name>.local:<PORT>
MDNS_NAME=bifrost

# Max size of a single uploaded file, in megabytes
MAX_UPLOAD_SIZE_MB=2048

# Max number of files in one upload request
MAX_FILES_PER_UPLOAD=20

# Comma-separated extension blocklist for uploads (belt-and-suspenders;
# uploads are never executed or served regardless)
UPLOAD_EXT_BLOCKLIST=.exe,.bat,.cmd,.msi

# Per-IP upload requests allowed per minute (cheap DoS insurance, even on a LAN)
UPLOAD_RATE_LIMIT_PER_MIN=60

# Shared clipboard: max entries kept (oldest-out past this) and per-entry size cap
CLIPBOARD_MAX_ENTRIES=100
CLIPBOARD_MAX_TEXT_KB=64

# Activity log retention — audit rows older than this many days are pruned
AUDIT_RETENTION_DAYS=90

# Runestone (JSON editor): max document size in kilobytes — beyond ~2 MB
# browser highlighting janks; also the storage guard once saving lands
RUNESTONE_MAX_DOC_KB=2048

# Edda (Markdown editor): max saved document size in kilobytes (413 over cap)
EDDA_MAX_DOC_KB=2048
# Above this size the live preview auto-degrades to a manual "Refresh preview"
# button so typing never blocks on rendering a huge document
EDDA_LIVE_PREVIEW_MAX_KB=300

# Loki (JavaScript workbench): Part B execution defaults (user-adjustable per
# run). Timeout is the watchdog that kills a runaway snippet; the console budget
# caps how many log entries a single run streams before truncation.
LOKI_RUN_TIMEOUT_MS=5000
LOKI_CONSOLE_MAX_ENTRIES=500
# Master switch for sandboxed execution ("Calcifer") and whether a run may call
# fetch() (useful for hitting your own LAN APIs). Both are Heimdall-overridable;
# execution is additionally never offered in the cloud profile.
LOKI_EXECUTION_ENABLED=true
LOKI_FETCH_ALLOWED=true

# Folder holding theme JSON files (built-ins committed; user themes join them)
# Theme add/delete now requires a Heimdall admin session (PLAN-05).
THEMES_DIR=./themes

# Root folder for all runtime state (uploads, downloads, tmp, data, logs)
STORAGE_ROOT=./storage

# PIN for the Heimdall admin panel. REQUIRED — no default, boot fails if empty.
HEIMDALL_PIN=

# Encryption key for the admin session cookie (≥ 32 chars). Optional: if unset,
# a random key is generated at boot and admin sessions reset on each restart.
# Set it to keep sessions alive across restarts.
HEIMDALL_SESSION_SECRET=

# Default keyboard shortcut to open Heimdall (runtime-editable copy lives in the DB)
HEIMDALL_SHORTCUT_DEFAULT=shift+meta+comma

# Number of taps on the hidden hotspot that opens Heimdall on touch devices
HEIMDALL_TAP_COUNT=7

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Where `npm run backup` writes archives (storage/ + themes/, .env only with
# --include-env). Empty = backups disabled.
BACKUP_DIR=

# Rotation: keep only the newest N archives in BACKUP_DIR. 0 = keep all.
BACKUP_KEEP=0
