# dependencies
node_modules/

# builds
dist/

# env & secrets
.env

# runtime storage — folders kept via .gitkeep, contents never committed
storage/*/*
!storage/*/.gitkeep

# logs
*.log

# baked build stamp (generated by scripts/gen-build-info.mjs at build time)
server/build-info.json

# generated roff man page (scripts/gen-man.ts, from cli/man/bifrost.1.md)
cli/man/bifrost.1

# pdf.js wasm decoders, copied out of node_modules by scripts/copy-pdf-wasm.ts
client/public/pdfjs-wasm/

# incremental typecheck cache (`tsc -b`)
*.tsbuildinfo

# npm pack output (the CLI install tarball, produced at build/release time)
*.tgz

# OS noise
.DS_Store

# Claude Code — skills are committed, local settings are not
.claude/settings.local.json
