{
  "name": "@bifrost/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/core/db/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.4.3",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "file-type": "^22.0.1",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.10"
