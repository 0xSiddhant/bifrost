{
  "name": "@bifrost/server",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "prebuild": "tsx ../scripts/gen-build-info.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/core/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ajv": "^8.20.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.4.3",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "file-type": "^22.0.1",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.10"
  }
}
